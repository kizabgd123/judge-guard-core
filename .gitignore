!data/raw/.gitkeep
!data/processed/.gitkeep

# Models and checkpoints
models/*.joblib
models/*.pkl
models/*.pt
models/*.onnx
catboost_info/
wandb/

# Submissions (keep folder)
submissions/*.csv
!submissions/.gitkeep

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDE / OS
.DS_Store
.vscode/
.idea/
*.log
